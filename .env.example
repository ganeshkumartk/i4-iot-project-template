# Server
PORT=3000
HOST=0.0.0.0

# Optional: shared secret between ESP32 and server (set same value in firmware/config.h)
DEVICE_API_KEY=

# Default thresholds (percent) — dashboard can override at runtime
DEFAULT_DRY_THRESHOLD=35
DEFAULT_WET_THRESHOLD=65

# Telemetry logging for analytics / ML follow-up sessions
DATA_LOGGING=true
# One file per session — change for each workshop day (e.g. 20260602-iisc-a)
DATA_SESSION_ID=
